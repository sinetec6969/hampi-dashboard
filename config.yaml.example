# HamPi Dashboard configuration
# Copy to config.yaml and edit. Env vars (old names) still override these.
# All keys optional — omitted keys use the defaults shown.

server:
  port: 8000
  # frontend_dist: ../frontend/dist
  # history_file: ../call_history.json

# rtl_device keys accept an index (0) or an EEPROM serial string ("HAMPI0").
# Serials survive replug/reboot reordering — set with: rtl_eeprom -d 0 -s HAMPI0
# Serials must be NON-numeric: rtl_tcp parses numeric -d values as an index.

sdr:                      # device 0 — mode switcher (DMR default)
  freq: 438800000
  gain: 49.6
  # rtl_device: 0
  # sample_rate: 2400000
  # chunk_size: 131072

airband:
  enable: true
  rtl_device: 1
  rtl_port: 1235
  gain: 40.0
  squelch: 0.01           # tune for your noise floor
  dwell_ms: 2000
  frequencies:
    - { freq: 121500000, label: "Guard" }
    - { freq: 123450000, label: "CTAF" }
    - { freq: 126200000, label: "Center" }
    - { freq: 132850000, label: "Departure" }

adsb:
  enable: false           # true = dedicated decoder on boot (needs own dongle)
  rtl_device: 2
  gain: -1                # negative = auto
  lat_ref: 0.0            # reference position — enables faster CPR decode
  lon_ref: 0.0

sstv:
  freq: 145800000         # 145.800 MHz ISS/2m
  gain: 40.0
  # image_dir: ../sstv_images

meteor:                   # METEOR-M LRPT weather imagery (needs: apt install satdump)
  freq: 137900000         # 137.9 primary / 137.1 backup
  gain: 42.0
  samplerate: 1000000
  pipeline: meteor_m2_lrpt
  # image_dir: ../meteor_images

qth:
  grid: EM95of            # Maidenhead locator — drives satellite pass prediction

# Satellites tracked on the SSTV page (Doppler + pass prediction vs AMSAT TLEs).
# Omit to use the built-in defaults (ISS, UmKA-1, SONATE-2).
# sstv_satellites:
#   - { norad: 25544, name: "ISS", freq: 145800000, mode: "FM · PD120", desc: "ARISS SSTV events" }

aprs:
  freq: 144390000         # North America APRS
  gain: 49.6

meshtastic:
  enable: true
  # port:                 # serial port — omit for auto-detect
  # port: /dev/meshtastic # stable name once 99-hampi.rules is installed

satellite:
  enable: true
  mqtt_host: localhost
  mqtt_port: 1883

# DMR caller-map geocoding queries nominatim.openstreetmap.org — city/state of
# heard callers leaves the LAN. Off by default; caller map shows no pins without it.
geocode:
  enable: false

talkgroups:               # DMR talkgroup aliases — shown next to TG numbers
  91: "Worldwide"
  93: "North America"
  3100: "US Bridge"
  3116: "Texas"

# Your station identity — REQUIRED before any transmit (legal ID).
station:
  callsign: ""            # e.g. "N0CALL" — TX refuses while blank
  ssid: 7                 # APRS SSID (7 = HT)
  lat: 0.0
  lon: 0.0
  comment: "HamPi"

# Transmit hardware (Digirig Mobile). TX is OFF by default — flip tx_enable
# only when callsign is set and you intend to go on the air.
radio:
  tx_enable: false        # master TX safety switch
  serial: /dev/digirig    # CP2102N — RTS keys PTT (install 99-hampi.rules)
  audio: hw:CARD=Device   # Digirig C-Media codec (`aplay -l` to confirm)

trunk:                    # SDRTrunk trunked-DMR (Connect Plus) — needs `sdrtrunk` systemd --user service + one RTL-SDR
  service: sdrtrunk       # systemctl --user unit name the dashboard start/stops
  site: Carolina Connect Site 004
  control_freq: 454031250 # control channel Hz
  vnc_url: "100.x.x.x:5901" # Tailscale VNC for the full SDRTrunk UI (optional)
